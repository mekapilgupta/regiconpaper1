# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Primary LLM Models for Transformation (Strictly Configured)
MODEL_PRIMARY_TRANSFORM=openai/gpt-5.6-luna
MODEL_SECONDARY_TRANSFORM=qwen/qwen3.8-flash

# Judge Models for Transformation Quality / Invariance Checking
MODEL_PRIMARY_JUDGE=google/gemini-3.8-flash
MODEL_SECONDARY_JUDGE=deepseek/deepseek-v4-pro

# Machine Translation & Embedding Models (Local Offline Inference)
MT_MODEL_NAME=ai4bharat/indictrans2-en-indic-1B
EMBEDDING_MODEL_BGE=BAAI/bge-m3
EMBEDDING_MODEL_E5_BASE=intfloat/multilingual-e5-base
EMBEDDING_MODEL_E5_LARGE=intfloat/multilingual-e5-large
EMBEDDING_MODEL_LABSE=sentence-transformers/LaBSE

# Experiment & Random Seed
EXPERIMENT_SEED=20260921
DEFAULT_LANGUAGES=as,bn
PILOT_SAMPLE_SIZE=150
FINAL_SAMPLE_SIZE=800
